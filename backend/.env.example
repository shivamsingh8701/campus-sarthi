# ============================================================
# CampusSarthi Backend — Environment Variables
# Copy this to .env and fill in your real values
#
# DEMO CREDENTIALS:
# Student Email: demo@galgotiasuniversity.org
# Student Password: DemoStudent@123
# LMS Username: 21SCSE101001
# LMS Password: DemoLMSPassword@123
# ============================================================

# Application
NODE_ENV=development
PORT=3001

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX
JWT_EXPIRY=7d

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX

# Supabase — from your project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# AI Keys
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-...

# Email (use Gmail App Password for simplest setup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Gmail OAuth2 (alternative to SMTP — leave blank if using SMTP above)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Encryption key for LMS session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# LMS
LMS_BASE_URL=https://gulms.galgotiasuniversity.org
LMS_LOGIN_URL=https://gulms.galgotiasuniversity.org/login/index.php

# Background sync interval in minutes (minimum 1, recommended 60)
SYNC_INTERVAL_MINUTES=60
